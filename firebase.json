{
  "hosting": {
    "predeploy": [
      "npm run build"
    ],
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      { "regex": "^/point-fantasy/escalacoes/?$", "destination": "/point-fantasy", "type": 301 },
      { "regex": "^/point-fantasy/$", "destination": "/point-fantasy", "type": 301 }
    ]
  }
}
